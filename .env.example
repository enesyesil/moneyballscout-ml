# Copy to .env for local runs; in Coolify set these as environment variables on the compose resource.

# --- API-Football (https://www.api-football.com) ---
API_FOOTBALL_KEY=
LEAGUES=39                 # comma-separated league ids (39 = Premier League, 140 LaLiga, 78 Bundesliga, 135 Serie A, 61 Ligue 1)
SEASON=2025                # season start year
DAILY_QUOTA=100            # free plan: 100/day; raise on a paid plan
PER_MINUTE_LIMIT=10        # free plan: 10/min
SYNC_CRON_HOUR=4           # daily sync + retrain, UTC

# --- Database ---
# local default is SQLite in backend/data/scout.db; with docker-compose.yml:
# DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout
POSTGRES_USER=scout
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scout

# --- Object storage (raw API responses, Transfermarkt snapshots, model artifacts) ---
# local default is the filesystem (backend/data/objects); with docker-compose.yml:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=scout
# S3_SECRET_KEY=scout-dev-secret
MINIO_ROOT_USER=scout
MINIO_ROOT_PASSWORD=change-me-too
S3_BUCKET=scout

# --- MLflow (optional locally; empty = runs are still recorded in model_runs) ---
# MLFLOW_TRACKING_URI=http://localhost:5001
